{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veil",
  "version": "0.7.2",
  "identifier": "veil",
  "build": {
    "beforeDevCommand": "pnpm --filter @veil/web build && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @veil/web build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Veil",
        "width": 1180,
        "height": 860,
        "minWidth": 480,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Collaborative document overlay with desktop peer connections",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/markdown.nsh",
        "displayLanguageSelector": false
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGQjkxMkQzNTJDMThEMUEKUldRYWpjRlMweEs1THhuT2I5bWhnc2FIU3p1MFUxRlgxSXNXN0s5VmZmQ3h1YXdOd3Rwb3lSd2EK",
      "endpoints": ["https://github.com/ahmad-fatayerji/veil/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["veil"]
      }
    }
  }
}
